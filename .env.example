APP_NAME="RGHB KPI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://richworks.performix.ai

# SESSION (IMPORTANT)
# Deliberately NOT redis: SESSION_DRIVER=redis was tried for real production
# use and repeatedly took the entire site down with a 500 on every single
# request (StartSession runs in the global web middleware group, before any
# route/controller) — most likely Railway's Redis was never actually
# attached/reachable at the app level, but regardless of the exact cause,
# the session driver is on every request's critical path and can't afford to
# depend on a service that hasn't been independently verified as reachable.
# `file` is the config this app was actually last confirmed working under,
# before Horizon/Redis were introduced. Switch back to `redis` only after
# manually confirming (e.g. `php artisan tinker --execute="Redis::ping();"`
# in the deployed environment) that Redis is genuinely reachable there.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=richworks.performix.ai
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false

# PROXY
TRUSTED_PROXIES=*

# SUPABASE (REST API — used by SupabaseService/SupabaseAuthService/SupabaseUserService)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# OPENAI (used by AiService — legacy ANIRA chat/scoring; the Platform's own
# ANIRA reuses the same key via chatForPlatform())
OPENAI_API_KEY=

# SUPABASE POSTGRES (direct connection — the separate `pgsql` connection used
# by Schema::connection('pgsql') migrations and the Company/Department/Role/
# KpiPermission Eloquent models. NOT the same credentials as the REST API
# above. Get this from the Supabase dashboard: Project Settings > Database >
# Connection string. SUPABASE_DB_URL alone is enough if set; the individual
# SUPABASE_DB_HOST/PORT/etc. below are only a fallback for hosts that don't
# support a single connection URI.
#
# Deliberately NOT named DB_URL/DB_HOST/etc: Laravel's default `sqlite`
# connection (config/database.php) also reads the generic DB_URL/DB_DATABASE
# as an override regardless of that connection's own driver — a Postgres
# DB_URL here would hijack the sqlite connection into running Postgres DDL
# against this database instead. Distinct names avoid that entirely.)
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# stderr, not the file-based "stack"/"single" default: this app runs under
# Railway (a container PaaS with no persistent disk to read a log file from),
# and Railway's log viewer only ever captures stdout/stderr — a file-based
# channel writes into the ephemeral container where nobody can see it. This
# was discovered the hard way: a real production 500 was completely
# undiagnosable from Railway's Deploy Logs (which only ever showed
# `php artisan serve`'s bare request-timing lines) until this was fixed.
LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=sqlite

# REDIS (only needed once SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION above
# are switched back to redis, after confirming it's actually reachable — see
# the SESSION_DRIVER comment above. If your host injects REDIS_URL, set it
# directly; host/port/password below are only a fallback.)
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Also deliberately file/sync, not redis, for the same reason as
# SESSION_DRIVER above. Horizon isn't started in production today anyway
# (the documented production command is plain `php artisan serve`), so
# QUEUE_CONNECTION=sync has no functional downside right now.
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="notification.kpi@richworks.com"
MAIL_FROM_NAME="${APP_NAME}"

DEFAULT_LOGIN_PASSWORD=Richworks
VITE_APP_NAME="${APP_NAME}"

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CRON_SECRET=
